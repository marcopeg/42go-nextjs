    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "pg-query-stream": "4.16.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.6",
