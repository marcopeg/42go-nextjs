{
  "name": "42go-nextjs",
  "version": "0.0.77",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/generate-app-icons-registry.mjs && node scripts/generate-app-themes-registry.mjs && next build && rm -f .next/standalone/.env .next/standalone/.env.*",
    "build:docker": "node scripts/generate-app-icons-registry.mjs && node scripts/generate-app-themes-registry.mjs && NEXT_TEST_WASM=1 next build --webpack && rm -f .next/standalone/.env .next/standalone/.env.*",
    "start": "next start",
    "lint": "eslint .",
    "test:email-validation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/email-validation.test.mts",
    "test:quicklist-refresh": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/quicklist-refresh.test.mts",
    "test:quicklist-api-access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/quicklist-api-access.test.mts",
    "test:quicklist-llm-reorder": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/quicklist-llm-reorder.test.mts",
    "test:quicklist-skill": "python3 -m unittest tests/quicklist_skill_test.py",
    "test:lingocafe-sentence-segmentation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/lingocafe-sentence-segmentation.test.mts",
    "test:lingocafe-translation-language": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/lingocafe-translation-language.test.mts",
    "test:lingocafe-book-completion": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/lingocafe-book-completion.test.mts",
    "test:pwa-install-targets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/pwa-install-targets.test.mts",
    "test:communications": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/communications.test.mts",
    "test:backoffice-users-routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/backoffice-users-routes.test.mts",
    "qa": "eslint . && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
